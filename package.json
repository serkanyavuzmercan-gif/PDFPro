{
  "name": "pdfpro",
  "productName": "PDFPro",
  "version": "0.3.0",
  "description": "PDFPro - Professional desktop PDF editor",
  "main": "./out/main/index.js",
  "author": "PDFPro",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "pdfjs-assets": "node scripts/copy-pdfjs-assets.mjs",
    "predev": "npm run pdfjs-assets",
    "prebuild": "npm run pdfjs-assets",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build": "npm run typecheck && electron-vite build",
    "dist:win": "npm run icons && npm run build && electron-builder --win",
    "dist:mac": "npm run icons && npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "i18next": "^26.7.2",
    "lucide-react": "^1.69.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "png-to-ico": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.1.13",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "zustand": "^5.0.16"
  }
}
